# hwdef do controlador de voo Aracuã-7 (STM32H743ZIT6, LQFP144)
# Processado por libraries/AP_HAL_ChibiOS/hwdef/scripts/chibios_hwdef.py

MCU STM32H7xx STM32H743xx
# ID provisório (faixa livre). Para distribuir o firmware, reserve um ID por PR em
# Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID 7108

# cristal HSE de 16 MHz em PH0/PH1
OSCILLATOR_HZ 16000000
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 128
STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

# estado padrão de todo pino não listado
DEFAULTGPIO OUTPUT LOW PULLDOWN

# ---------- USB e SWD ----------
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# ---------- Seriais ----------
# SERIAL0 USB, 1 TELEM1, 2 TELEM2/companion, 3 GPS1, 4 GPS2, 5 RC, 6 ESC telem, 7 extra
SERIAL_ORDER OTG1 UART7 USART2 USART1 UART8 USART6 UART5 USART3

# TELEM1: rádio de telemetria 900 MHz (com RTS/CTS)
PE7 UART7_RX UART7
PE8 UART7_TX UART7
PF8 UART7_RTS UART7
PF9 UART7_CTS UART7

# TELEM2: computador de bordo, reserva da Ethernet (com RTS/CTS)
PD6 USART2_RX USART2
PD5 USART2_TX USART2
PD4 USART2_RTS USART2
PD3 USART2_CTS USART2

# GPS1 (mastro: GPS + bússola no I2C1)
PA10 USART1_RX USART1
PA9  USART1_TX USART1

# GPS2 (segundo F9P para rumo por GPS)
PE0 UART8_RX UART8
PE1 UART8_TX UART8

# RC: receptor ExpressLRS (CRSF, full duplex)
PC7 USART6_RX USART6
PC6 USART6_TX USART6

# Telemetria do ESC 4-em-1 (só RX é usado)
PB5 UART5_RX UART5 NODMA
PB6 UART5_TX UART5 NODMA

# Extra / depuração
PD9 USART3_RX USART3 NODMA
PD8 USART3_TX USART3 NODMA

define DEFAULT_SERIAL1_PROTOCOL SerialProtocol_MAVLink2
define DEFAULT_SERIAL1_BAUD 57
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_MAVLink2
define DEFAULT_SERIAL2_BAUD 921
define DEFAULT_SERIAL3_PROTOCOL SerialProtocol_GPS
define DEFAULT_SERIAL4_PROTOCOL SerialProtocol_GPS
define DEFAULT_SERIAL5_PROTOCOL SerialProtocol_RCIN
define DEFAULT_SERIAL6_PROTOCOL SerialProtocol_ESCTelemetry
define DEFAULT_SERIAL7_PROTOCOL SerialProtocol_None

# ---------- SPI ----------
# SPI1: IMU1 ICM-42688-P
PA5 SPI1_SCK  SPI1
PA6 SPI1_MISO SPI1
PD7 SPI1_MOSI SPI1
PC15 IMU1_CS CS

# SPI4: IMU2 BMI270 (outro fabricante, outro barramento)
PE2 SPI4_SCK  SPI4
PE5 SPI4_MISO SPI4
PE6 SPI4_MOSI SPI4
PE4 IMU2_CS CS

# SPI3: conector de expansão (fluxo óptico, terceira IMU)
PB3 SPI3_SCK  SPI3
PB4 SPI3_MISO SPI3
PB2 SPI3_MOSI SPI3
PD10 EXT_CS1 CS

SPIDEV icm42688 SPI1 DEVID1 IMU1_CS MODE3 2*MHZ 16*MHZ
SPIDEV bmi270   SPI4 DEVID1 IMU2_CS MODE3 1*MHZ 10*MHZ
SPIDEV ext1     SPI3 DEVID1 EXT_CS1 MODE3 2*MHZ 2*MHZ
DMA_NOSHARE SPI1* SPI4*

IMU Invensensev3 SPI:icm42688 ROTATION_NONE
IMU BMI270 SPI:bmi270 ROTATION_NONE
define HAL_DEFAULT_INS_FAST_SAMPLE 3

# ---------- I2C ----------
# índice 0 = I2C2 interno (barômetro, monitor de energia); índice 1 = I2C1 externo (bússola do GPS)
I2C_ORDER I2C2 I2C1
PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2
PB8  I2C1_SCL I2C1
PB9  I2C1_SDA I2C1
define HAL_I2C_INTERNAL_MASK 1

BARO DPS310 I2C:0:0x76
define AP_COMPASS_PROBING_ENABLED 1
define HAL_COMPASS_AUTO_ROT_DEFAULT 2

# Monitor de energia INA238 (shunt de 0,25 mOhm) no I2C interno
define HAL_BATT_MONITOR_DEFAULT 21
define HAL_BATTMON_INA2XX_BUS 0
define HAL_BATTMON_INA2XX_ADDR 0x40
define DEFAULT_BATTMON_INA2XX_SHUNT 0.00025
define DEFAULT_BATTMON_INA2XX_MAX_AMPS 160.0

# ---------- CAN (DroneCAN) ----------
PD0 CAN1_RX CAN1
PD1 CAN1_TX CAN1
PF4 GPIO_CAN1_SILENT OUTPUT PUSHPULL SPEED_LOW LOW GPIO(70)
PB12 CAN2_RX CAN2
PB13 CAN2_TX CAN2
PF5 GPIO_CAN2_SILENT OUTPUT PUSHPULL SPEED_LOW LOW GPIO(71)

# ---------- Ethernet RMII (PHY LAN8742A, cristal de 25 MHz) ----------
PC1  ETH_MDC          ETH1
PA2  ETH_MDIO         ETH1
PC4  ETH_RMII_RXD0    ETH1
PC5  ETH_RMII_RXD1    ETH1
PG13 ETH_RMII_TXD0    ETH1
PG12 ETH_RMII_TXD1    ETH1
PG11 ETH_RMII_TX_EN   ETH1
PA7  ETH_RMII_CRS_DV  ETH1
PA1  ETH_RMII_REF_CLK ETH1
PG10 PHY_NRST OUTPUT HIGH GPIO(72)
define BOARD_PHY_ID MII_LAN8742A_ID
define BOARD_PHY_RMII

# ---------- Motores (DShot; TIM1 com DShot bidirecional para RPM) ----------
PE9  TIM1_CH1 TIM1 PWM(1) GPIO(50) BIDIR
PE11 TIM1_CH2 TIM1 PWM(2) GPIO(51)
PE13 TIM1_CH3 TIM1 PWM(3) GPIO(52) BIDIR
PE14 TIM1_CH4 TIM1 PWM(4) GPIO(53)
# Saídas 5-8 (TIM4): servos dos compartimentos de entrega ENT1-ENT4 (PWM de 50 Hz)
PD12 TIM4_CH1 TIM4 PWM(5) GPIO(54)
PD13 TIM4_CH2 TIM4 PWM(6) GPIO(55)
PD14 TIM4_CH3 TIM4 PWM(7) GPIO(56)
PD15 TIM4_CH4 TIM4 PWM(8) GPIO(57)
# LED endereçável WS2812
PB0  TIM3_CH3 TIM3 PWM(9) GPIO(58)

# Saídas 10-11: servos de entrega ENT5 e ENT6 (um timer cada, livres do DShot)
PF6  TIM16_CH1 TIM16 PWM(10) GPIO(59)
PF7  TIM17_CH1 TIM17 PWM(11) GPIO(60)

# Buzzer
PA15 TIM2_CH1 TIM2 GPIO(32) ALARM

# ---------- ADC ----------
PC0 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PA4 BATT_CURRENT_SENS ADC1 SCALE(1)
PB1 VDD_5V_SENS       ADC1 SCALE(2)
PA0 RSSI_ADC          ADC1
PA3 SPARE_ADC         ADC1
# backup analógico do ESC 4-em-1 (BATT2): tensão por divisor 1:11, corrente do ESC
define HAL_BATT2_VOLT_PIN 10
define HAL_BATT2_CURR_PIN 18
define HAL_BATT2_VOLT_SCALE 11.0
define HAL_BATT2_CURR_SCALE 40.0
define BOARD_RSSI_ANA_PIN 16

# ---------- microSD ----------
PC8  SDMMC1_D0  SDMMC1
PC9  SDMMC1_D1  SDMMC1
PC10 SDMMC1_D2  SDMMC1
PC11 SDMMC1_D3  SDMMC1
PC12 SDMMC1_CK  SDMMC1
PD2  SDMMC1_CMD SDMMC1
define HAL_OS_FATFS_IO 1

# ---------- GPIO ----------
PE3 LED0 OUTPUT LOW GPIO(90)
PG7 LED1 OUTPUT LOW GPIO(91)
define AP_NOTIFY_GPIO_LED_2_ENABLED 1
define HAL_GPIO_A_LED_PIN 91
define HAL_GPIO_B_LED_PIN 90

# aquecedor das IMUs (MOSFET + resistores)
PG4 HEATER_EN OUTPUT LOW GPIO(80)
define HAL_HEATER_GPIO_PIN 80
define HAL_HAVE_IMU_HEATER 1
define HAL_IMU_TEMP_DEFAULT 45

# PINIO: liga/desliga 5 V do computador de bordo e do LiDAR
PG5 PINIO1 OUTPUT GPIO(81) HIGH
PG6 PINIO2 OUTPUT GPIO(82) HIGH
define RELAY1_PIN_DEFAULT 81
define RELAY2_PIN_DEFAULT 82

# ---------- Sistema de entrega ----------
# Chaves de confirmação dos compartimentos (fecham para GND quando o pino está travado)
PF0  ENT_SW1 INPUT PULLUP GPIO(101)
PF1  ENT_SW2 INPUT PULLUP GPIO(102)
PF2  ENT_SW3 INPUT PULLUP GPIO(103)
PF3  ENT_SW4 INPUT PULLUP GPIO(104)
PF10 ENT_SW5 INPUT PULLUP GPIO(105)
PF11 ENT_SW6 INPUT PULLUP GPIO(106)
# Saídas de solenoide/eletroímã (MOSFET de lado baixo, alimentado pelo trilho VSERVO)
PG2  ENT_SOL1 OUTPUT LOW PULLDOWN GPIO(83)
PG3  ENT_SOL2 OUTPUT LOW PULLDOWN GPIO(84)
# Liga o buck de 5 V dos servos (VSERVO); começa ligado para os servos segurarem o pino
PG8  PINIO3 OUTPUT HIGH GPIO(85)
# scripts Lua (entrega.lua lê as chaves e manda o estado à estação)
define AP_SCRIPTING_ENABLED 1

DMA_PRIORITY SDMMC* TIM1* SPI1* SPI4* ETH* USART6* UART7*
define HAL_STORAGE_SIZE 32768
STORAGE_FLASH_PAGE 14
